# gdlint configuration. Run via `make lint`.
# Only the rules that deviate from gdtoolkit's defaults are listed here;
# dump the full default set with `gdlint --dump-default-config`.

# Declaration-ordering inside a class. Disabled deliberately: an @onready var
# reads best beside the plain vars it relates to, and an enum beside the consts
# it indexes; satisfying the rule means reshuffling declarations for no
# correctness benefit.
disable:
- class-definitions-order

# Surfaces is the only door to spatial questions (D6, D13), so every query a rule,
# a bot or the HUD asks is one public method on it; its index (SH18) lands behind
# the same door. gdtoolkit's default is 20.
max-public-methods: 26

# MatchSim is the one tick (D2): the brawl, the sinking and the sea are each private
# steps of it in §4's order, and together outgrow the default 1000 lines.
max-file-lines: 1100
