#!/usr/bin/env python
# The game's GDExtension (#410), built by `make native` (tools/native_build.sh), which
# fetches godot-cpp at its pinned commit into build/godot-cpp first. Writes
# lib/libsinking_native.<platform>.<arch>.<ext> and, beside it, the
# sinking_native.gdextension that loads it — written only once the library is built, so
# a checkout that has not built it has no extension for Godot to miss and runs the
# GDScript (ai/walk_search.gd).
import os

env = Environment(tools=["default"], PLATFORM="")
Export("env")
env = SConscript("build/godot-cpp/SConstruct")

# The same answers as GDScript, bit for bit (D4): no a * b + c fused into one rounding
# where GDScript rounds twice. clang contracts by default on arm64, gcc in GNU mode.
if env.get("is_msvc", False):
    env.Append(CCFLAGS=["/fp:precise"])
else:
    env.Append(CCFLAGS=["-ffp-contract=off", "-fno-fast-math"])

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

# One library a platform and architecture, whatever the target: the editor and the
# exports load the same optimized build.
platform = env["platform"]
arch = env["arch"]
name = "libsinking_native.{}.{}".format(platform, arch)
library = env.SharedLibrary("lib/" + name + env["SHLIBSUFFIX"], source=sources)

# Every platform's library in lib/ is listed, not only this build's: a library built
# elsewhere (CI's native-* artifacts) put beside this one is exported with the game for
# its platform (make export-win on a Mac, say), each export taking its own.
LIBRARY_SUFFIXES = (".so", ".dll", ".dylib")


def library_feature(name):
    # libsinking_native.<platform>.<arch>.<ext>; a macOS build is universal.
    platform, arch = name.split(".")[1:3]
    return "macos" if platform == "macos" else "{}.{}".format(platform, arch)


def libraries_in_lib():
    names = set()
    for node in Glob("lib/libsinking_native.*"):
        name = os.path.basename(str(node))
        if name.endswith(LIBRARY_SUFFIXES) and len(name.split(".")) == 4:
            names.add(name)
    return names


def write_gdextension(target, source, env):
    names = libraries_in_lib() | {os.path.basename(str(source[0]))}
    lines = [
        "; Written by `make native` (native/SConstruct) beside the libraries it loads.",
        "[configuration]",
        "",
        'entry_symbol = "sinking_native_init"',
        'compatibility_minimum = "4.7"',
        "reloadable = false",
        "",
        "[libraries]",
        "",
    ]
    for name in sorted(names):
        lines.append('{} = "res://native/lib/{}"'.format(library_feature(name), name))
    lines.append("")
    with open(str(target[0]), "w", encoding="utf-8", newline="\n") as out:
        out.write("\n".join(lines))


# Rewritten when the set of libraries in lib/ changes, as well as on a new build.
listed = env.Value(sorted(libraries_in_lib()))
extension = env.Command("lib/sinking_native.gdextension", [library, listed], write_gdextension)
Default(library, extension)
