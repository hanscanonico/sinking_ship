[gd_resource type="Resource" script_class="WreckHull" format=3]

[ext_resource type="Script" path="res://tests/fixtures/wrecks/wreck_hull.gd" id="1_wreck"]
[ext_resource type="Script" path="res://core/sinking/flood_cell.gd" id="2_cell"]
[ext_resource type="Script" path="res://core/sinking/ship_opening.gd" id="3_opening"]

[sub_resource type="Resource" id="Cell_bunkers_s"]
script = ExtResource("2_cell")
name = &"bunkers_s"
low = Vector3(-10, -8.5, 10.25)
high = Vector3(34, 3, 13.25)
kind = 5
permeability = 0.5

[sub_resource type="Resource" id="Opening_hole"]
script = ExtResource("3_opening")
name = &"hole_bunkers_s"
kind = 12
joins = Array[StringName]([&"bunkers_s", &"sea"])
centre = Vector3(12, -3, 13.25)
size = Vector3(4.47, 4.47, 0)
area = 20.0

[resource]
script = ExtResource("1_wreck")
name = &"lusitania"
length = 140.0
beam = 26.5
depth = 17.0
draught = 10.0
centre_height = 9.85
cells = Array[ExtResource("2_cell")]([SubResource("Cell_bunkers_s")])
openings = Array[ExtResource("3_opening")]([SubResource("Opening_hole")])
boat_limit_deg = 15.0
notes = "Lusitania, torpedoed on 7 May 1915. Beam 26.5 m (source). Box length 140 m: her 240 m overall at a block coefficient near 0.58 (est.), at a 10 m draught (est.). Depth 17 m (est.). Weight 9.85 m over her keel: GM 1.0 m (est.). Her starboard coal bunkers alongside two boiler rooms, 44 m long and 3 m deep inboard of her side, from 1.5 m to 13 m over her keel, half full of coal (est.: bunker permeability 0.5), opened by a 20 m² hole 3 m under her waterline (est.: a torpedo and the boiler explosion after it)."
