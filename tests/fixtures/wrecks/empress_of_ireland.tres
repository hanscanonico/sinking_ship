[resource]
script = ExtResource("1_wreck")
name = &"empress_of_ireland"
length = 135.0
beam = 20.0
depth = 13.0
draught = 8.0
centre_height = 7.3
cells = Array[ExtResource("2_cell")]([SubResource("Cell_bunker_s"), SubResource("Cell_bunker_p"), SubResource("Cell_boiler_rooms"), SubResource("Cell_engine_room"), SubResource("Cell_hold_aft"), SubResource("Cell_hold_fwd"), SubResource("Cell_decks_s"), SubResource("Cell_decks_p")])
openings = Array[ExtResource("3_opening")]([SubResource("Opening_hole_bunker_s"), SubResource("Opening_breach_boiler_rooms"), SubResource("Opening_passage_decks"), SubResource("Opening_hatch_hold_aft"), SubResource("Opening_hatch_hold_aft_p"), SubResource("Opening_hatch_hold_fwd"), SubResource("Opening_hatch_hold_fwd_p"), SubResource("Opening_skylight_engine"), SubResource("Opening_port_s1"), SubResource("Opening_port_s2"), SubResource("Opening_port_s3"), SubResource("Opening_port_s4"), SubResource("Opening_port_s5"), SubResource("Opening_port_s6"), SubResource("Opening_port_s7"), SubResource("Opening_port_s8"), SubResource("Opening_port_s9"), SubResource("Opening_port_s10"), SubResource("Opening_port_s11"), SubResource("Opening_port_s12"), SubResource("Opening_port_s13"), SubResource("Opening_port_s14"), SubResource("Opening_port_s15"), SubResource("Opening_port_s16"), SubResource("Opening_port_s17"), SubResource("Opening_port_s18"), SubResource("Opening_port_s19"), SubResource("Opening_port_s20"), SubResource("Opening_port_p1"), SubResource("Opening_port_p2"), SubResource("Opening_port_p3"), SubResource("Opening_port_p4"), SubResource("Opening_port_p5"), SubResource("Opening_port_p6"), SubResource("Opening_port_p7"), SubResource("Opening_port_p8"), SubResource("Opening_port_p9"), SubResource("Opening_port_p10"), SubResource("Opening_port_p11"), SubResource("Opening_port_p12"), SubResource("Opening_port_p13"), SubResource("Opening_port_p14"), SubResource("Opening_port_p15"), SubResource("Opening_port_p16"), SubResource("Opening_port_p17"), SubResource("Opening_port_p18"), SubResource("Opening_port_p19"), SubResource("Opening_port_p20")])
fittings = Array[ExtResource("4_fitting")]([SubResource("Fitting_generator")])
boat_limit_deg = 15.0
notes = "Empress of Ireland, struck by Storstad in the St Lawrence on 29 May 1914 and gone in 14 minutes, lying on her starboard side (sources). Beam 20 m (source, 19.8). Box length 135 m: her 167.6 m overall at a block coefficient near 0.8 of it (est.), at an 8.0 m draught (est.). Depth 13 m from her keel to her upper deck (est.). Weight 7.3 m over her keel: GM about 0.87 m (est.). Storstad's bow opened a hole about 4.3 m wide and 7.6 m tall (source: 14 by 25 ft) into her starboard coal bunker, here 32 m2 3 m under her waterline, the bunker 2 m deep inboard and half full of coal (permeability 0.5), as is the port one, and through its inner wall 5.0 m2 into her two boiler rooms between them, one space 56 m long to 0.5 m over her waterline (est.). Fore and aft of them her engine room and her holds, and over all of them her cabins, a starboard and a port half joined amidships, 0.5 to 5 m over her waterline, the holds and the engine room open to them by hatches and a skylight (est.). Each side has 20 sidescuttles of 0.04 m2, 0.9 m over her waterline (est.) — left open on a warm night (source), shut for the other bake. Her dynamos stand at the after end of the boiler rooms on their floor (est.), drowned under 1 m of water or stopped past 25 degrees of list (est., SOLAS-based), with no emergency power (est.)."
