#!/bin/bash
# One-time install of the GitHub Actions self-hosted runner the deploy workflow
# targets (runs-on: [sinking-ship-prod]), with that label alone. Run on the mini PC
# as the deploy user. Registering needs no root, but installing the systemd service
# does, so finish with:
#   sudo ~/actions-runner-sinking-ship/svc.sh install "$USER" && sudo ~/actions-runner-sinking-ship/svc.sh start
# Usage: deploy/bin/setup_runner <registration-token>
#   token: gh api -X POST repos/hanscanonico/sinking_ship/actions/runners/registration-token --jq .token
# Personal-account runners are repo-scoped, so this gets its own directory, name and
# service beside the runners other repositories installed here.
# This repository is PUBLIC: read deploy/README.md's "The runner" before running this.
set -euo pipefail

REPO_URL="https://github.com/hanscanonico/sinking_ship"
RUNNER_DIR="$HOME/actions-runner-sinking-ship"
TOKEN="${1:?usage: deploy/bin/setup_runner <registration-token>}"

release=$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest)
version=$(jq -r '.tag_name | ltrimstr("v")' <<<"$release")
archive="actions-runner-linux-x64-${version}.tar.gz"
expected_sha=$(jq -r '.body' <<<"$release" |
	sed -n 's/.*<!-- BEGIN SHA linux-x64 -->\([0-9a-f]\{64\}\)<!-- END SHA linux-x64 -->.*/\1/p')
[ -n "$expected_sha" ] || {
	echo "No linux-x64 checksum in the v${version} release notes" >&2
	exit 1
}

mkdir -p "$RUNNER_DIR"
cd "$RUNNER_DIR"
curl -fsSL -o "$archive" "https://github.com/actions/runner/releases/download/v${version}/${archive}"
echo "${expected_sha}  ${archive}" | sha256sum -c -
tar xzf "$archive"
rm "$archive"

./config.sh --unattended --replace \
	--url "$REPO_URL" \
	--token "$TOKEN" \
	--name mini-pc-sinking-ship \
	--labels sinking-ship-prod \
	--no-default-labels

echo
echo "Runner registered. Install and start it as a service (needs root):"
echo "  sudo $RUNNER_DIR/svc.sh install $(id -un) && sudo $RUNNER_DIR/svc.sh start"
