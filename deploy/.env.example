# Copy to deploy/.env on the mini PC and fill in. deploy/.env is gitignored — never
# commit it. It holds the tunnel's token: keep it readable by the deploy user only
# (chmod 600 deploy/.env).
# Keep comments on their own lines: compose reads `KEY= # note` as part of the value.
# deploy/bin/deploy also needs curl, jq and flock on the host, beside docker compose.

# The Cloudflare Tunnel's token (Zero Trust → Networks → Tunnels → the tunnel →
# its docker run command). Empty: the stack runs without the tunnel, reachable only
# on 127.0.0.1:8120.
CLOUDFLARE_TUNNEL_TOKEN=

# The SHA-512 sums the image build checks Godot's downloads against, copied from
# SHA512-SUMS.txt of the godot-builds release the Dockerfile names (GODOT_VERSION):
# the lines for Godot_v<version>_linux.x86_64.zip and
# Godot_v<version>_export_templates.tpz. Not secrets; required.
GODOT_EDITOR_SHA512=
GODOT_TEMPLATES_SHA512=
